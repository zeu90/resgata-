
"use client";

import Link from "next/link";
import { useCallback, useEffect, useMemo, useState, type FormEvent } from "react";
import { useRouter } from "next/navigation";
import { getSupabaseBrowserClient } from "@/lib/supabase";
import type { Debt, DebtPriority } from "@/types";

const money = (value: number) =>
  Number(value).toLocaleString("pt-BR", {
    style: "currency",
    currency: "BRL",
  });

function localDate() {
  const date = new Date();
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
}

function dateLabel(value: string) {
  if (!value) return "—";
  const [year, month, day] = value.slice(0, 10).split("-");
  return `${day}/${month}/${year}`;
}

function errorMessage(error: unknown): string {
  if (error && typeof error === "object" && "message" in error) {
    const message = String(error.message);
    const code = "code" in error ? String(error.code) : "";

    if (code === "23502") {
      return "Há um campo obrigatório vazio. Confira o nome, credor, valor e vencimento.";
    }
    if (code === "23503") {
      return "Não foi possível vincular a dívida à sua conta. Saia e entre novamente.";
    }
    if (code === "23514") {
      return "Um dos valores informados não é permitido. Confira a categoria, prioridade e valor.";
    }
    if (code === "42501" || code === "PGRST301") {
      return "O banco bloqueou esta operação por segurança. Confira sua sessão e as permissões da conta.";
    }

    return message;
  }

  return "Não foi possível concluir a operação. Tente novamente.";
}

type Feedback = { type: "success" | "error"; message: string };

export default function DebtsPage() {
  const router = useRouter();

  const [items, setItems] = useState<Debt[]>([]);
  const [name, setName] = useState("");
  const [creditor, setCreditor] = useState("");
  const [amount, setAmount] = useState("");
  const [dueDate, setDueDate] = useState("");
  const [category, setCategory] = useState("outra");
  const [priority, setPriority] = useState<DebtPriority>("normal");

  const [feedback, setFeedback] = useState<Feedback | null>(null);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [actionId, setActionId] = useState<string | null>(null);
  const [filter, setFilter] = useState("todas");

  const refresh = useCallback(async () => {
    const supabase = getSupabaseBrowserClient();
    const { data: auth, error: authError } = await supabase.auth.getUser();

    if (authError) throw authError;

    if (!auth.user) {
      router.replace("/login");
      return;
    }

    const { data, error } = await supabase
      .from("debts")
      .select("*")
      .order("due_date", { ascending: true });

    if (error) throw error;

    setItems((data ?? []) as Debt[]);
  }, [router]);

  useEffect(() => {
    let active = true;

    async function load() {
      try {
        await refresh();
      } catch (error) {
        if (active) {
          setFeedback({ type: "error", message: errorMessage(error) });
        }
      } finally {
        if (active) setLoading(false);
      }
    }

    void load();

    return () => {
      active = false;
    };
  }, [refresh]);

  const today = localDate();

  const getStatus = useCallback(
    (item: Debt) => {
      if (item.status === "pago") return "pago";
      if (item.status === "atrasado" || item.due_date < today) return "atrasado";
      return "pendente";
    },
    [today]
  );

  const totals = useMemo(() => {
    return items.reduce(
      (result, item) => {
        const value = Number(item.amount) || 0;
        const status =
          item.status === "pago"
            ? "pago"
            : item.status === "atrasado" || item.due_date < today
              ? "atrasado"
              : "pendente";

        if (status === "pago") {
          result.paid += value;
        } else {
          result.open += value;
          if (status === "atrasado") result.overdue += value;
          else result.upcoming += value;
        }

        return result;
      },
      { open: 0, overdue: 0, upcoming: 0, paid: 0 }
    );
  }, [items, today]);

  const filteredItems = useMemo(() => {
    if (filter === "todas") return items;
    return items.filter((item) => getStatus(item) === filter);
  }, [filter, getStatus, items]);

  async function addDebt(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setFeedback(null);

    const cleanName = name.trim();
    const cleanCreditor = creditor.trim();
    const numericAmount = Number(amount);

    if (!cleanName || !cleanCreditor || !amount || !dueDate) {
      setFeedback({
        type: "error",
        message: "Preencha todos os campos obrigatórios, incluindo o credor.",
      });
      return;
    }

    if (!Number.isFinite(numericAmount) || numericAmount <= 0) {
      setFeedback({
        type: "error",
        message: "Informe um valor maior que zero.",
      });
      return;
    }

    if (dueDate < "1900-01-01") {
      setFeedback({
        type: "error",
        message: "Confira a data de vencimento.",
      });
      return;
    }

    setSaving(true);

    try {
      const supabase = getSupabaseBrowserClient();
      const { data: auth, error: authError } = await supabase.auth.getUser();

      if (authError) throw authError;

      if (!auth.user) {
        router.replace("/login");
        return;
      }

      const { error } = await supabase.from("debts").insert({
        user_id: auth.user.id,
        name: cleanName,
        creditor: cleanCreditor,
        amount: numericAmount,
        due_date: dueDate,
        category,
        priority,
        status: "pendente",
      });

      if (error) throw error;

      setName("");
      setCreditor("");
      setAmount("");
      setDueDate("");
      setCategory("outra");
      setPriority("normal");

      await refresh();

      setFeedback({
        type: "success",
        message: "Dívida cadastrada com sucesso.",
      });
    } catch (error) {
      setFeedback({
        type: "error",
        message: `Não foi possível salvar a dívida: ${errorMessage(error)}`,
      });
    } finally {
      setSaving(false);
    }
  }

  async function markPaid(item: Debt) {
    if (item.status === "pago") return;

    setFeedback(null);
    setActionId(item.id);

    try {
      const supabase = getSupabaseBrowserClient();
      const { data: auth, error: authError } = await supabase.auth.getUser();

      if (authError) throw authError;
      if (!auth.user) {
        router.replace("/login");
        return;
      }

      const { error } = await supabase
        .from("debts")
        .update({ status: "pago" })
        .eq("id", item.id)
        .eq("user_id", auth.user.id);

      if (error) throw error;

      await refresh();
      setFeedback({ type: "success", message: "Dívida marcada como paga." });
    } catch (error) {
      setFeedback({ type: "error", message: errorMessage(error) });
    } finally {
      setActionId(null);
    }
  }

  async function removeDebt(item: Debt) {
    const confirmed = window.confirm(
      `Deseja excluir "${item.name}"? Esta ação não pode ser desfeita.`
    );

    if (!confirmed) return;

    setFeedback(null);
    setActionId(item.id);

    try {
      const supabase = getSupabaseBrowserClient();
      const { data: auth, error: authError } = await supabase.auth.getUser();

      if (authError) throw authError;
      if (!auth.user) {
        router.replace("/login");
        return;
      }

      const { error } = await supabase
        .from("debts")
        .delete()
        .eq("id", item.id)
        .eq("user_id", auth.user.id);

      if (error) throw error;

      await refresh();
      setFeedback({ type: "success", message: "Dívida excluída." });
    } catch (error) {
      setFeedback({ type: "error", message: errorMessage(error) });
    } finally {
      setActionId(null);
    }
  }

  const cardStyle = {
    background: "var(--card, #ffffff)",
    border: "1px solid var(--border, #e5eaf0)",
    borderRadius: 18,
    padding: 20,
    minWidth: 0,
  } as const;

  const labelStyle = {
    display: "block",
    fontSize: 13,
    fontWeight: 600,
    marginBottom: 7,
  } as const;

  const inputStyle = {
    width: "100%",
    minWidth: 0,
    boxSizing: "border-box" as const,
    padding: "12px 13px",
    borderRadius: 10,
    border: "1px solid var(--border, #dbe2ea)",
    background: "var(--input, #ffffff)",
    color: "var(--foreground, #172033)",
    fontSize: 14,
  };

  const statusLabel: Record<string, string> = {
    pago: "Paga",
    pendente: "Em aberto",
    atrasado: "Vencida",
  };

  return (
    <main className="container page" style={{ maxWidth: 1180 }}>
      <nav
        className="nav"
        style={{ marginBottom: 28, flexWrap: "wrap", gap: 12 }}
      >
        <Link className="brand" href="/">
          Resgata<span> Dívidas</span>
        </Link>
        <div className="navlinks" style={{ flexWrap: "wrap" }}>
          <Link href="/dashboard">Painel</Link>
          <Link href="/dividas" aria-current="page">Dívidas</Link>
          <Link href="/financeiro">Financeiro</Link>
          <Link href="/apostas">Sem apostas</Link>
          <Link href="/perfil">Perfil</Link>
        </div>
      </nav>

      <header
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          flexWrap: "wrap",
          gap: 16,
          marginBottom: 26,
        }}
      >
        <div>
          <p
            style={{
              color: "var(--muted, #64748b)",
              fontSize: 13,
              fontWeight: 700,
              letterSpacing: 1,
              textTransform: "uppercase",
              margin: "0 0 8px",
            }}
          >
            Organização financeira
          </p>
          <h1 style={{ fontSize: "clamp(2rem, 5vw, 2.7rem)", margin: 0 }}>
            Minhas dívidas
          </h1>
          <p style={{ color: "var(--muted, #64748b)", margin: "10px 0 0" }}>
            Organize seus compromissos e acompanhe sua evolução.
          </p>
        </div>

        <a
          href="#nova-divida"
          className="btn primary"
          style={{
            display: "inline-flex",
            alignItems: "center",
            justifyContent: "center",
            textDecoration: "none",
            padding: "12px 18px",
            borderRadius: 11,
            fontWeight: 700,
          }}
        >
          + Nova dívida
        </a>
      </header>

      {feedback && (
        <div
          role={feedback.type === "error" ? "alert" : "status"}
          style={{
            padding: "13px 16px",
            borderRadius: 12,
            marginBottom: 20,
            border:
              feedback.type === "error"
                ? "1px solid #fecaca"
                : "1px solid #a7f3d0",
            background: feedback.type === "error" ? "#fef2f2" : "#ecfdf5",
            color: feedback.type === "error" ? "#991b1b" : "#065f46",
            overflowWrap: "anywhere",
          }}
        >
          {feedback.message}
          <button
            type="button"
            onClick={() => setFeedback(null)}
            aria-label="Fechar mensagem"
            style={{
              float: "right",
              border: 0,
              background: "transparent",
              cursor: "pointer",
              color: "inherit",
              fontSize: 18,
            }}
          >
            ×
          </button>
        </div>
      )}

      <section
        aria-label="Resumo financeiro"
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(min(100%, 210px), 1fr))",
          gap: 14,
          marginBottom: 24,
        }}
      >
        {[
          {
            title: "Total em aberto",
            value: totals.open,
            description: "Compromissos não pagos",
            accent: "#0f766e",
          },
          {
            title: "Valor vencido",
            value: totals.overdue,
            description: "Precisa de atenção",
            accent: "#b91c1c",
          },
          {
            title: "A vencer",
            value: totals.upcoming,
            description: "Vencimento hoje ou futuro",
            accent: "#1d4ed8",
          },
          {
            title: "Marcado como pago",
            value: totals.paid,
            description: "Pagamentos registrados",
            accent: "#047857",
          },
        ].map((card) => (
          <article key={card.title} style={cardStyle}>
            <div
              style={{
                width: 36,
                height: 4,
                borderRadius: 10,
                background: card.accent,
                marginBottom: 16,
              }}
            />
            <p
              style={{
                color: "var(--muted, #64748b)",
                fontSize: 13,
                fontWeight: 600,
                margin: "0 0 8px",
              }}
            >
              {card.title}
            </p>
            <p
              style={{
                fontSize: "clamp(1.35rem, 3vw, 1.8rem)",
                fontWeight: 800,
                letterSpacing: "-0.7px",
                margin: "0 0 8px",
                overflowWrap: "anywhere",
              }}
            >
              {money(card.value)}
            </p>
            <p
              style={{
                color: "var(--muted, #64748b)",
                fontSize: 12,
                margin: 0,
              }}
            >
              {card.description}
            </p>
          </article>
        ))}
      </section>

      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(min(100%, 310px), 0.8fr))",
          alignItems: "start",
          gap: 20,
        }}
      >
        <section id="nova-divida" style={cardStyle}>
          <div style={{ marginBottom: 20 }}>
            <h2 style={{ fontSize: 20, margin: "0 0 7px" }}>
              Adicionar dívida
            </h2>
            <p
              style={{
                color: "var(--muted, #64748b)",
                fontSize: 13,
                lineHeight: 1.6,
                margin: 0,
              }}
            >
              Informe os dados para acompanhar este compromisso.
            </p>
          </div>

          <form onSubmit={addDebt} style={{ display: "grid", gap: 16 }}>
            <div>
              <label htmlFor="debt-name" style={labelStyle}>Nome da dívida *</label>
              <input
                id="debt-name"
                style={inputStyle}
                required
                maxLength={120}
                placeholder="Ex.: Fatura do cartão"
                value={name}
                onChange={(event) => setName(event.target.value)}
              />
            </div>

            <div>
              <label htmlFor="debt-creditor" style={labelStyle}>Credor *</label>
              <input
                id="debt-creditor"
                style={inputStyle}
                required
                maxLength={120}
                placeholder="Ex.: Banco ou empresa"
                value={creditor}
                onChange={(event) => setCreditor(event.target.value)}
              />
            </div>

            <div>
              <label htmlFor="debt-amount" style={labelStyle}>Valor (R$) *</label>
              <input
                id="debt-amount"
                style={inputStyle}
                type="number"
                min="0.01"
                max="9999999999.99"
                step="0.01"
                inputMode="decimal"
                required
                placeholder="0,00"
                value={amount}
                onChange={(event) => setAmount(event.target.value)}
              />
            </div>

            <div>
              <label htmlFor="debt-date" style={labelStyle}>Vencimento *</label>
              <input
                id="debt-date"
                style={inputStyle}
                type="date"
                required
                value={dueDate}
                onChange={(event) => setDueDate(event.target.value)}
              />
            </div>

            <div>
              <label htmlFor="debt-category" style={labelStyle}>Categoria *</label>
              <select
                id="debt-category"
                style={inputStyle}
                value={category}
                onChange={(event) => setCategory(event.target.value)}
              >
                <option value="outra">Outra</option>
                <option value="cartao">Cartão</option>
                <option value="emprestimo">Empréstimo</option>
                <option value="conta">Conta</option>
                <option value="financiamento">Financiamento</option>
              </select>
            </div>

            <div>
              <label htmlFor="debt-priority" style={labelStyle}>Prioridade *</label>
              <select
                id="debt-priority"
                style={inputStyle}
                value={priority}
                onChange={(event) =>
                  setPriority(event.target.value as DebtPriority)
                }
              >
                <option value="baixa">Baixa</option>
                <option value="normal">Normal</option>
                <option value="alta">Alta</option>
              </select>
            </div>

            <button
              className="btn primary"
              type="submit"
              disabled={saving}
              style={{
                width: "100%",
                padding: 13,
                borderRadius: 11,
                fontWeight: 700,
                cursor: saving ? "wait" : "pointer",
              }}
            >
              {saving ? "Salvando..." : "Salvar dívida"}
            </button>

            <p
              style={{
                color: "var(--muted, #64748b)",
                fontSize: 12,
                lineHeight: 1.5,
                margin: 0,
              }}
            >
              * Campos obrigatórios. Seus registros são protegidos pelas
              permissões da sua conta.
            </p>
          </form>
        </section>

        <section style={{ ...cardStyle, minWidth: 0 }}>
          <div
            style={{
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              flexWrap: "wrap",
              gap: 12,
              marginBottom: 18,
            }}
          >
            <div>
              <h2 style={{ fontSize: 20, margin: "0 0 6px" }}>Histórico</h2>
              <p
                style={{
                  color: "var(--muted, #64748b)",
                  fontSize: 13,
                  margin: 0,
                }}
              >
                {items.length} {items.length === 1 ? "registro" : "registros"}
              </p>
            </div>

            <select
              aria-label="Filtrar dívidas por situação"
              value={filter}
              onChange={(event) => setFilter(event.target.value)}
              style={{ ...inputStyle, width: "auto", maxWidth: "100%" }}
            >
              <option value="todas">Todas</option>
              <option value="pendente">Em aberto</option>
              <option value="atrasado">Vencidas</option>
              <option value="pago">Pagas</option>
            </select>
          </div>

          {loading ? (
            <div style={{ padding: "36px 10px", textAlign: "center" }}>
              <p style={{ margin: 0 }}>Carregando suas dívidas...</p>
            </div>
          ) : filteredItems.length === 0 ? (
            <div
              style={{
                padding: "38px 16px",
                borderRadius: 14,
                background: "var(--surface, #f8fafc)",
                textAlign: "center",
              }}
            >
              <div
                aria-hidden="true"
                style={{ fontSize: 30, marginBottom: 12 }}
              >
                {items.length === 0 ? "▤" : "⌕"}
              </div>
              <h3 style={{ fontSize: 16, margin: "0 0 8px" }}>
                {items.length === 0
                  ? "Nenhuma dívida cadastrada"
                  : "Nenhum resultado neste filtro"}
              </h3>
              <p
                style={{
                  color: "var(--muted, #64748b)",
                  fontSize: 13,
                  lineHeight: 1.6,
                  margin: 0,
                }}
              >
                {items.length === 0
                  ? "Adicione sua primeira dívida para começar a acompanhar os valores."
                  : "Escolha outra situação para visualizar seus registros."}
              </p>
            </div>
          ) : (
            <div style={{ display: "grid", gap: 12 }}>
              {filteredItems.map((item) => {
                const status = getStatus(item);
                const badgeColors =
                  status === "pago"
                    ? { background: "#d1fae5", color: "#065f46" }
                    : status === "atrasado"
                      ? { background: "#fee2e2", color: "#991b1b" }
                      : { background: "#dbeafe", color: "#1e40af" };

                return (
                  <article
                    key={item.id}
                    style={{
                      border: "1px solid var(--border, #e5eaf0)",
                      borderRadius: 13,
                      padding: 15,
                      minWidth: 0,
                    }}
                  >
                    <div
                      style={{
                        display: "flex",
                        justifyContent: "space-between",
                        alignItems: "flex-start",
                        gap: 12,
                        flexWrap: "wrap",
                      }}
                    >
                      <div style={{ minWidth: 0, flex: "1 1 150px" }}>
                        <h3
                          style={{
                            fontSize: 15,
                            margin: "0 0 5px",
                            overflowWrap: "anywhere",
                          }}
                        >
                          {item.name}
                        </h3>
                        <p
                          style={{
                            color: "var(--muted, #64748b)",
                            fontSize: 13,
                            margin: 0,
                            overflowWrap: "anywhere",
                          }}
                        >
                          {item.creditor}
                        </p>
                      </div>

                      <span
                        style={{
                          ...badgeColors,
                          padding: "5px 9px",
                          borderRadius: 999,
                          fontSize: 11,
                          fontWeight: 700,
                          whiteSpace: "nowrap",
                        }}
                      >
                        {statusLabel[status]}
                      </span>
                    </div>

                    <div
                      style={{
                        display: "flex",
                        justifyContent: "space-between",
                        alignItems: "end",
                        flexWrap: "wrap",
                        gap: 10,
                        marginTop: 16,
                      }}
                    >
                      <div>
                        <p
                          style={{
                            color: "var(--muted, #64748b)",
                            fontSize: 11,
                            margin: "0 0 4px",
                          }}
                        >
                          Valor
                        </p>
                        <strong style={{ fontSize: 18 }}>
                          {money(Number(item.amount))}
                        </strong>
                      </div>
                      <div>
                        <p
                          style={{
                            color: "var(--muted, #64748b)",
                            fontSize: 11,
                            margin: "0 0 4px",
                          }}
                        >
                          Vencimento
                        </p>
                        <span style={{ fontSize: 13, fontWeight: 600 }}>
                          {dateLabel(item.due_date)}
                        </span>
                      </div>
                    </div>

                    <div
                      style={{
                        display: "flex",
                        gap: 8,
                        flexWrap: "wrap",
                        marginTop: 15,
                        paddingTop: 13,
                        borderTop: "1px solid var(--border, #e5eaf0)",
                      }}
                    >
                      {status !== "pago" && (
                        <button
                          type="button"
                          className="btn"
                          disabled={actionId === item.id}
                          onClick={() => void markPaid(item)}
                        >
                          {actionId === item.id ? "Aguarde..." : "Marcar como paga"}
                        </button>
                      )}
                      <button
                        type="button"
                        className="btn"
                        disabled={actionId === item.id}
                        onClick={() => void removeDebt(item)}
                        style={{ color: "#b91c1c" }}
                      >
                        Excluir
                      </button>
                    </div>
                  </article>
                );
              })}
            </div>
          )}
        </section>
      </div>

      <footer
        style={{
          color: "var(--muted, #64748b)",
          fontSize: 12,
          textAlign: "center",
          marginTop: 28,
          lineHeight: 1.6,
        }}
      >
        Resgata Dívidas · Acompanhe seus compromissos com mais clareza.
        <br />
        Os totais são calculados com base nos registros salvos nesta conta.
      </footer>
    </main>
  );
}
