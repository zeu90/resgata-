                 </p>
               </div>
             )}
           </section>
         )}

         {fileName && (
            <p style={{ color: "#64748b", overflowWrap: "anywhere" }}>
              Arquivo em processamento: <strong>{fileName}</strong>
            </p>
          )}
          {loading && <p role="status">Lendo documento. Aguarde...</p>}
          {error && (
            <p role="alert" style={{
              padding: "14px 16px",
              borderRadius: 12,
              border: "1px solid #f3caca",
              background: "#fff5f5",
