              Destino dos dados
            </label>
            <select
              id="document-kind"
              value={kind}
              onChange={(event) => {
                setKind(event.target.value as ImportKind);
                setReviewReady(false);
                setMessage("");
              }}
              style={inputStyle}
            >
              <option value="divida">Dívidas — importar cobranças pendentes</option>
              <option value="saldo">Finanças — atualizar saldo de uma conta</option>
            </select>

