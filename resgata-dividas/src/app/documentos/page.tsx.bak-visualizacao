                  style={inputStyle}
                  required
                >
                  <option value="">Selecione uma conta</option>
                  {wallets.map((wallet) => (
                    <option key={wallet.id} value={wallet.id}>
                      {wallet.name} — saldo atual: {money(Number(wallet.balance))}
                    </option>
                  ))}
                </select>
                <p style={{ color: "#64748b", fontSize: 13, lineHeight: 1.5 }}>
                  O saldo confirmado substituirá o saldo atual; ele não será somado.
                </p>
              </>
            )}

            <button
              type="submit"
              disabled={saving || loading}
              style={{
                width: "100%",
                marginTop: 18,
                padding: "15px 18px",
                border: 0,
                borderRadius: 14,
                background: saving || loading
                  ? "#91aeb4"
                  : reviewReady
                    ? "linear-gradient(135deg, #15803d, #0f766e)"
                    : "linear-gradient(135deg, #087e8b, #075985)",
                color: "#fff",
                fontSize: 16,
                fontWeight: 800,
                boxShadow: "0 8px 18px rgba(8,126,139,.18)",
                cursor: saving || loading ? "wait" : "pointer",
              }}
            >
              {saving
                ? "Salvando..."
                : reviewReady
                  ? "✓ Confirmar e salvar dados"
                  : "Preparar planilha para conferência"}
            </button>

            {reviewReady && (
              <section
                aria-label="Planilha de conferência dos dados extraídos"
                style={{
                  marginTop: 22,
                  padding: 18,
                  borderRadius: 18,
                  border: "1px solid #bfdbfe",
                  background: "linear-gradient(135deg, #eff6ff, #f0fdfa)",
                  boxShadow: "0 8px 24px rgba(30,64,110,.07)",
                }}
              >
                <div style={{
                  display: "flex",
                  flexWrap: "wrap",
                  justifyContent: "space-between",
                  alignItems: "center",
                  gap: 10,
                  marginBottom: 14,
                }}>
                  <div>
                    <h3 style={{ margin: 0, fontSize: 19, color: "#172033" }}>
                      Planilha de conferência
                    </h3>
                    <p style={{ margin: "5px 0 0", color: "#64748b", fontSize: 13 }}>
                      Confira os valores antes de gravar no sistema.
                    </p>
                  </div>
                  <span style={{
                    padding: "6px 10px",
                    borderRadius: 999,
                    background: "#dbeafe",
                    color: "#1d4ed8",
                    fontWeight: 800,
                    fontSize: 12,
                  }}>
                    {kind === "divida" ? "DÍVIDAS" : "SALDO FINANCEIRO"}
                  </span>
                </div>

                <div style={{ overflowX: "auto", borderRadius: 12, background: "#fff" }}>
                  <table style={{
                    width: "100%",
                    borderCollapse: "collapse",
                    minWidth: 600,
                    fontSize: 13,
                  }}>
                    <thead>
                      <tr style={{ background: "#e0f2fe", color: "#164e63" }}>
                        {(kind === "saldo"
                          ? ["Conta", "Saldo extraído", "Arquivo"]
                          : csvRows.length > 1
                            ? csvRows[0]
                            : ["Descrição", "Credor", "Vencimento", "Valor (R$)"]
                        ).map((heading, index) => (
                          <th key={index} style={{
                            padding: "12px 14px",
                            borderBottom: "1px solid #cbd5e1",
                            textAlign: "left",
                            whiteSpace: "nowrap",
                          }}>
                            {heading || `Coluna ${index + 1}`}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {kind === "saldo" ? (
                        <tr>
                          <td style={{ padding: 12, borderBottom: "1px solid #e2e8f0" }}>
                            {wallets.find((wallet) => wallet.id === walletId)?.name || "Conta não selecionada"}
                          </td>
                          <td style={{ padding: 12, borderBottom: "1px solid #e2e8f0", fontWeight: 800, color: "#0f766e" }}>
                            {money(parseAmount(amount))}
                          </td>
                          <td style={{ padding: 12, borderBottom: "1px solid #e2e8f0", overflowWrap: "anywhere" }}>
                            {fileName || "—"}
                          </td>
                        </tr>
                      ) : csvRows.length > 1 ? (
                        csvRows.slice(1, 101).map((row, rowIndex) => (
                          <tr key={rowIndex} style={{ background: rowIndex % 2 ? "#f8fafc" : "#fff" }}>
                            {csvRows[0].map((_, columnIndex) => (
                              <td key={columnIndex} style={{
                                padding: "11px 14px",
                                borderBottom: "1px solid #e2e8f0",
                                whiteSpace: "nowrap",
                              }}>
                                {row[columnIndex] || "—"}
                              </td>
                            ))}
                          </tr>
                        ))
                      ) : (
                        <tr>
                          <td style={{ padding: 12, borderBottom: "1px solid #e2e8f0" }}>
                            {name.trim() || "Dívida importada"}
                          </td>
                          <td style={{ padding: 12, borderBottom: "1px solid #e2e8f0" }}>
                            {creditor.trim() || "Não identificado"}
                          </td>
                          <td style={{ padding: 12, borderBottom: "1px solid #e2e8f0" }}>
                            {date || "Data não identificada"}
                          </td>
                          <td style={{ padding: 12, borderBottom: "1px solid #e2e8f0", fontWeight: 800, color: "#b45309" }}>
                            {money(parseAmount(amount))}
                          </td>
                        </tr>
                      )}
                    </tbody>
                  </table>
                </div>

                <p style={{ margin: "12px 0 0", color: "#475569", fontSize: 13, lineHeight: 1.6 }}>
                  {kind === "divida" && csvRows.length > 1
                    ? `Prévia de até 100 linhas. A importação considera as linhas válidas reconhecidas como dívidas.`
                    : "Esta é a prévia dos dados extraídos. Confira o valor e o destino antes de salvar."}
                </p>
              </section>
            )}
          </form>

          {extractedText && (
            <details style={{ marginTop: 24 }}>
              <summary style={{ cursor: "pointer", fontWeight: 700 }}>
                Conferir texto extraído
              </summary>
              <pre style={{
                whiteSpace: "pre-wrap",
                overflowWrap: "anywhere",
                maxHeight: 300,
                overflow: "auto",
                padding: 14,
                background: "#f4f8fa",
                borderRadius: 10,
                fontSize: 12,
              }}>
                {extractedText.slice(0, 20000)}
              </pre>
            </details>
          )}
        </section>

        <p style={{
          color: "#64748b",
          fontSize: 13,
          lineHeight: 1.7,
          marginTop: 18,
        }}>
          Privacidade: esta página não envia os arquivos para o armazenamento
          do Supabase. O processamento ocorre temporariamente no navegador.
          Os valores só são gravados depois da confirmação. Confira sempre
          os dados extraídos antes de salvar.
        </p>
      </div>
    </main>
  );
}

const labelStyle: React.CSSProperties = {
  display: "block",
  marginTop: 18,
  marginBottom: 7,
  fontWeight: 700,
  fontSize: 14,
};

const inputStyle: React.CSSProperties = {
  display: "block",
  width: "100%",
  boxSizing: "border-box",
  minHeight: 48,
  padding: "12px 14px",
  border: "1px solid #cbd5e1",
  borderRadius: 12,
  background: "#fff",
  color: "#172033",
  fontSize: 15,
  outlineColor: "#087e8b",
};
