"use client";

import Link from "next/link";
import { useEffect, useRef, useState } from "react";
import { useRouter } from "next/navigation";
import { getSupabaseBrowserClient } from "@/lib/supabase";

type Wallet = {
  id: string;
  name: string;
  account_type: string;
  balance: number | string;
};

type ImportKind = "divida" | "saldo";

const money = (value: number) =>
  value.toLocaleString("pt-BR", {
    style: "currency",
    currency: "BRL",
  });

function parseAmount(value: string): number {
  let cleaned = value.replace(/[R$\s]/g, "");
  if (cleaned.includes(",")) {
    cleaned = cleaned.replace(/\./g, "").replace(",", ".");
  }
  return Number(cleaned);
}

function findAmount(text: string): string {
  const matches = [
    ...text.matchAll(
      /(?:R\$\s*)?(\d{1,3}(?:\.\d{3})*,\d{2}|\d+,\d{2}|\d+\.\d{2})/g,
    ),
  ];
  return matches.at(-1)?.[1]?.replace(/\./g, "").replace(",", ".") ?? "";
}

function findDate(text: string): string {
  const match = text.match(/\b(\d{2})[\/.-](\d{2})[\/.-](\d{4})\b/);
  if (!match) return "";
  const [, day, month, year] = match;
  const date = `${year}-${month}-${day}`;
  const parsed = new Date(`${date}T12:00:00`);
  return Number.isNaN(parsed.getTime()) ? "" :
    parsed.toISOString().slice(0, 10);
}

function parseCSV(text: string): string[][] {
  const rows: string[][] = [];
  let row: string[] = [];
  let cell = "";
  let quoted = false;

  for (let i = 0; i < text.length; i++) {
    const char = text[i];

    if (char === '"' && quoted && text[i + 1] === '"') {
      cell += '"';
      i++;
    } else if (char === '"') {
      quoted = !quoted;
    } else if ((char === "," || char === ";" || char === "\t") && !quoted) {
      row.push(cell.trim());
      cell = "";
    } else if ((char === "\n" || char === "\r") && !quoted) {
      if (char === "\r" && text[i + 1] === "\n") i++;
      row.push(cell.trim());
      if (row.some(Boolean)) rows.push(row);
      row = [];
      cell = "";
    } else {
      cell += char;
    }
  }

  row.push(cell.trim());
  if (row.some(Boolean)) rows.push(row);
  return rows;
}

async function readDocument(file: File): Promise<string> {
  const name = file.name.toLowerCase();

  if (name.endsWith(".csv")) {
    return await file.text();
  }

  if (file.type.startsWith("image/")) {
    const Tesseract = await import("tesseract.js");
    const result = await Tesseract.recognize(file, "por+eng");
    return result.data.text;
  }

  if (name.endsWith(".pdf") || file.type === "application/pdf") {
    const pdfjs = await import("pdfjs-dist/legacy/build/pdf.mjs");
    pdfjs.GlobalWorkerOptions.workerSrc =
      `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${pdfjs.version}/pdf.worker.min.mjs`;

    const bytes = new Uint8Array(await file.arrayBuffer());
    const pdf = await pdfjs.getDocument({ data: bytes }).promise;
    const pages: string[] = [];

    for (let i = 1; i <= Math.min(pdf.numPages, 15); i++) {
      const page = await pdf.getPage(i);
      const content = await page.getTextContent();
      pages.push(
        content.items
          .map((item) => ("str" in item ? item.str : ""))
          .join(" "),
      );
    }

    const text = pages.join("\n");
    if (text.trim()) return text;

    throw new Error(
      "Este PDF não contém texto selecionável. Tire uma captura de tela ou envie uma imagem para usar o OCR.",
    );
  }

  throw new Error("Formato não suportado. Envie PDF, JPG, PNG ou CSV.");
}


function buildCsvDebtRows(text: string, userId: string) {
  const rows = parseCSV(text);
  if (rows.length < 2) return [];

  const normalize = (value: string) =>
    value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();

  const headers = rows[0].map(normalize);
  const amountIndex = headers.findIndex((h) =>
    /^(valor|valor da divida|valor devido|amount|total)$/.test(h)
  );
  const dateIndex = headers.findIndex((h) =>
    /vencimento|data de vencimento|due date/.test(h)
  );
  const nameIndex = headers.findIndex((h) =>
    /descricao|nome|historico|description/.test(h)
  );
  const creditorIndex = headers.findIndex((h) =>
    /credor|empresa|instituicao|fornecedor|creditor/.test(h)
  );

  if (amountIndex < 0) return [];

  const result: {
    user_id: string;
    name: string;
    creditor: string;
    amount: number;
    due_date: string | null;
    category: string;
    priority: string;
    status: string;
  }[] = [];

  const seen = new Set<string>();

  for (const row of rows.slice(1)) {
    const rawAmount = row[amountIndex] ?? "";
    const amount = parseAmount(rawAmount);
    if (!rawAmount.trim() || !Number.isFinite(amount) || amount <= 0) continue;

    const name = (nameIndex >= 0 ? row[nameIndex] : "").trim()
      || "Dívida importada";
    const creditor = (creditorIndex >= 0 ? row[creditorIndex] : "").trim()
      || "Não identificado";

    const rawDate = dateIndex >= 0 ? (row[dateIndex] ?? "").trim() : "";
    let dueDate: string | null = null;
    if (/^\d{4}-\d{2}-\d{2}$/.test(rawDate)) {
      dueDate = rawDate;
    } else if (rawDate) {
      dueDate = findDate(rawDate) || null;
    }

    const key = [
      normalize(name), normalize(creditor), amount.toFixed(2), dueDate ?? ""
    ].join("|");

    if (seen.has(key)) continue;
    seen.add(key);

    result.push({
      user_id: userId,
      name,
      creditor,
      amount,
      due_date: dueDate,
      category: "outra",
      priority: "normal",
      status: "pendente",
    });
  }

  return result;
}

export default function DocumentosPage() {
  const router = useRouter();
  const inputRef = useRef<HTMLInputElement>(null);

  const [userId, setUserId] = useState("");
  const [wallets, setWallets] = useState<Wallet[]>([]);
  const [kind, setKind] = useState<ImportKind>("divida");
  const [walletId, setWalletId] = useState("");
  const [fileName, setFileName] = useState("");
  const [extractedText, setExtractedText] = useState("");
  const [name, setName] = useState("");
  const [creditor, setCreditor] = useState("");
  const [amount, setAmount] = useState("");
  const [date, setDate] = useState("");
  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState("");
  const [error, setError] = useState("");
  const [csvRows, setCsvRows] = useState<string[][]>([]);

  useEffect(() => {
    let active = true;

    async function load() {
      const supabase = getSupabaseBrowserClient();
      const { data, error: authError } = await supabase.auth.getUser();

      if (!active) return;
      if (authError || !data.user) {
        router.replace("/login");
        return;
      }

      setUserId(data.user.id);

      const { data: accounts, error: accountError } = await supabase
        .from("wallet_accounts")
        .select("id,name,account_type,balance")
        .eq("user_id", data.user.id)
        .order("created_at", { ascending: true });

      if (!active) return;

      if (accountError) {
        setError("Não foi possível carregar suas contas financeiras.");
        return;
      }

      setWallets((accounts ?? []) as Wallet[]);
      if (accounts?.length) setWalletId(accounts[0].id);
    }

    void load();
    return () => {
      active = false;
    };
  }, [router]);

  async function handleFile(file?: File) {
    if (!file) return;

    setLoading(true);
    setError("");
    setMessage("");
    setFileName(file.name);
    setExtractedText("");
    setCsvRows([]);

    try {
      const text = await readDocument(file);
      setExtractedText(text);

      if (file.name.toLowerCase().endsWith(".csv")) {
        const rows = parseCSV(text);
        setCsvRows(rows);

        if (rows.length > 1) {
          setMessage(
            `CSV lido: ${rows.length - 1} linhas de dados. Confira a tabela antes de importar.`,
          );

          const headers = rows[0].map((h) => h.toLowerCase());
          const amountIndex = headers.findIndex((h) =>
            /valor|saldo|amount|total/.test(h),
          );
          const dateIndex = headers.findIndex((h) =>
            /data|vencimento|date/.test(h),
          );
          const descriptionIndex = headers.findIndex((h) =>
            /descri|nome|credor|hist.rico|description/.test(h),
          );

          const first = rows[1];
          if (amountIndex >= 0 && first[amountIndex]) {
            setAmount(String(parseAmount(first[amountIndex])));
          }
          if (dateIndex >= 0 && first[dateIndex]) {
            setDate(findDate(first[dateIndex]) || first[dateIndex]);
          }
          if (descriptionIndex >= 0 && first[descriptionIndex]) {
            setName(first[descriptionIndex]);
            setCreditor(first[descriptionIndex]);
          }
        } else {
          setError("O CSV não contém linhas de dados suficientes.");
        }
      } else {
        setAmount(findAmount(text));
        setDate(findDate(text));

        const lines = text
          .split(/\r?\n/)
          .map((line) => line.trim())
          .filter(Boolean);

        const candidate = lines.find(
          (line) =>
            line.length >= 3 &&
            !/R\$|saldo|vencimento|vencida|pagamento|extrato/i.test(line),
        );

        if (candidate) {
          setName(candidate.slice(0, 100));
          setCreditor(candidate.slice(0, 100));
        }

        setMessage(
          "Leitura concluída. Confira e corrija os campos antes de salvar.",
        );
      }
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Não foi possível ler o documento.",
      );
    } finally {
      setLoading(false);
    }
  }

  async function saveRecord(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setError("");
    setMessage("");

    if (!userId) {
      setError("Sua sessão expirou. Entre novamente.");
      router.replace("/login");
      return;
    }

    const numericAmount = parseAmount(amount);

    if (!Number.isFinite(numericAmount) || numericAmount < 0 ||
        (kind === "divida" && numericAmount <= 0)) {
      setError("Confira o valor informado.");
      return;
    }


    if (kind === "saldo" && !walletId) {
      setError("Cadastre ou selecione uma conta em Finanças primeiro.");
      return;
    }

    setSaving(true);

    try {
      const supabase = getSupabaseBrowserClient();

      if (kind === "divida") {
        if (fileName.toLowerCase().endsWith(".csv") && csvRows.length > 1) {
          const batch = buildCsvDebtRows(extractedText, userId);
          if (!batch.length) {
            throw new Error(
              "Não encontrei valores positivos numa coluna reconhecida. Confira se o CSV possui uma coluna chamada Valor ou Amount."
            );
          }

          const { error: batchError } = await supabase.from("debts").insert(batch);
          if (batchError) throw batchError;

          setMessage(`${batch.length} dívida(s) importada(s). Confira na página Dívidas.`);
          setAmount("");
          setName("");
          setCreditor("");
          setDate("");
          setExtractedText("");
          setCsvRows([]);
          setFileName("");
          if (inputRef.current) inputRef.current.value = "";
          return;
        }

        const { error: insertError } = await supabase.from("debts").insert({
          user_id: userId,
          name: name.trim() || "Dívida importada",
          creditor: creditor.trim() || "Não identificado",
          amount: numericAmount,
          due_date: date || null,
          category: "outra",
          priority: "normal",
          status: "pendente",
        });

        if (insertError) throw insertError;
        setMessage("Dívida cadastrada. Confira na página Dívidas.");
      } else {
        const { error: updateError } = await supabase
          .from("wallet_accounts")
          .update({
            balance: numericAmount,
            updated_at: new Date().toISOString(),
          })
          .eq("id", walletId)
          .eq("user_id", userId);

        if (updateError) throw updateError;
        setMessage("Saldo atualizado. Confira na página Finanças.");
      }

      setAmount("");
      setName("");
      setCreditor("");
      setDate("");
      setExtractedText("");
      setCsvRows([]);
      setFileName("");
      if (inputRef.current) inputRef.current.value = "";
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Não foi possível salvar os dados.",
      );
    } finally {
      setSaving(false);
    }
  }

  return (
    <main style={{
      minHeight: "100vh",
      background: "#f4f8fa",
      color: "#16313b",
      padding: "24px 16px 48px",
    }}>
      <div style={{ maxWidth: 1000, margin: "0 auto" }}>
        <header style={{
          display: "flex",
          flexWrap: "wrap",
          alignItems: "center",
          justifyContent: "space-between",
          gap: 16,
          marginBottom: 28,
        }}>
          <div>
            <Link href="/dashboard" style={{
              color: "#087e8b",
              textDecoration: "none",
              fontWeight: 700,
            }}>
              ← Voltar ao painel
            </Link>
            <h1 style={{ margin: "14px 0 6px", fontSize: "clamp(28px, 4vw, 38px)" }}>
              Documentos
            </h1>
            <p style={{ margin: 0, color: "#58717a", lineHeight: 1.6 }}>
              Extraia valores e datas sem arquivar os documentos originais.
            </p>
          </div>
          <nav style={{ display: "flex", flexWrap: "wrap", gap: 12 }}>
            <Link href="/dividas">Dívidas</Link>
            <Link href="/financeiro">Finanças</Link>
          </nav>
        </header>

        <section style={{
          background: "#fff",
          border: "1px solid #dce8ec",
          borderRadius: 20,
          padding: "clamp(18px, 4vw, 30px)",
          boxShadow: "0 10px 35px rgba(24,58,70,.05)",
        }}>
          <h2 style={{ marginTop: 0 }}>1. Envie um documento</h2>
          <p style={{ color: "#58717a", lineHeight: 1.6 }}>
            Formatos aceitos: PDF, JPG, PNG e CSV. A leitura pode exigir
            conexão com a internet para carregar os recursos de OCR.
          </p>

          <input
            ref={inputRef}
            type="file"
            accept=".pdf,.csv,.jpg,.jpeg,.png,.webp,application/pdf,text/csv,image/*"
            onChange={(event) => void handleFile(event.target.files?.[0])}
            style={{
              display: "block",
              width: "100%",
              boxSizing: "border-box",
              padding: 16,
              border: "1px dashed #8eb8c0",
              borderRadius: 12,
              background: "#f7fbfc",
            }}
          />

          {fileName && (
            <p style={{ color: "#58717a", overflowWrap: "anywhere" }}>
              Arquivo em processamento: <strong>{fileName}</strong>
            </p>
          )}
          {loading && <p role="status">Lendo documento. Aguarde...</p>}
          {error && (
            <p role="alert" style={{
              padding: 12,
              borderRadius: 10,
              background: "#fff0f0",
              color: "#a52323",
            }}>
              {error}
            </p>
          )}
          {message && (
            <p role="status" style={{
              padding: 12,
              borderRadius: 10,
              background: "#e9f8f2",
              color: "#12634b",
            }}>
              {message}
            </p>
          )}

          {csvRows.length > 0 && (
            <div style={{ overflowX: "auto", marginTop: 20 }}>
              <h3>Prévia do CSV</h3>
              <table style={{
                width: "100%",
                borderCollapse: "collapse",
                background: "#fff",
              }}>
                <tbody>
                  {csvRows.slice(0, 11).map((row, index) => (
                    <tr key={index}>
                      {row.map((cell, column) => {
                        const Tag = index === 0 ? "th" : "td";
                        return (
                          <Tag key={column} style={{
                            textAlign: "left",
                            padding: 9,
                            border: "1px solid #dce8ec",
                            whiteSpace: "nowrap",
                          }}>
                            {cell}
                          </Tag>
                        );
                      })}
                    </tr>
                  ))}
                </tbody>
              </table>
              {csvRows.length > 11 && (
                <p>Mostrando as primeiras 10 linhas de dados.</p>
              )}
              <p>
                Para dívidas, ao confirmar, as linhas válidas com valores
                positivos serão importadas em lote. Linhas sem valor válido
                serão ignoradas; revise a tabela antes de confirmar.
              </p>
            </div>
          )}

          <form onSubmit={saveRecord} style={{ marginTop: 28 }}>
            <h2>2. Confira os dados extraídos</h2>

            <label htmlFor="document-kind" style={labelStyle}>
              Tipo de informação
            </label>
            <select
              id="document-kind"
              value={kind}
              onChange={(event) => setKind(event.target.value as ImportKind)}
              style={inputStyle}
            >
              <option value="divida">Dívida que falta pagar</option>
              <option value="saldo">Saldo de uma conta existente</option>
            </select>

            {kind === "saldo" ? (
              <>
                <label htmlFor="document-wallet" style={labelStyle}>
                  Conta que terá o saldo atualizado
                </label>
                <select
                  id="document-wallet"
                  value={walletId}
                  onChange={(event) => setWalletId(event.target.value)}
                  style={inputStyle}
                  required
                >
                  <option value="">Selecione uma conta</option>
                  {wallets.map((wallet) => (
                    <option key={wallet.id} value={wallet.id}>
                      {wallet.name} — saldo atual: {money(Number(wallet.balance))}
                    </option>
                  ))}
                </select>
                <p style={{ color: "#58717a", fontSize: 13 }}>
                  Será substituído o saldo atual pelo valor confirmado, não
                  somado a ele. Confira a data do documento antes de salvar.
                </p>
              </>
            ) : (
              <>
                <label htmlFor="document-name" style={labelStyle}>
                  Descrição da dívida
                </label>
                <input
                  id="document-name"
                  value={name}
                  onChange={(event) => setName(event.target.value)}
                  style={inputStyle}
                  maxLength={150}
                  placeholder="Ex.: Fatura do cartão"
                />

                <label htmlFor="document-creditor" style={labelStyle}>
                  Credor
                </label>
                <input
                  id="document-creditor"
                  value={creditor}
                  onChange={(event) => setCreditor(event.target.value)}
                  style={inputStyle}
                  maxLength={150}
                  placeholder="Ex.: Banco ou empresa"
                />

                <label htmlFor="document-date" style={labelStyle}>
                  Data de vencimento
                </label>
                <input
                  id="document-date"
                  type="date"
                  value={date}
                  onChange={(event) => setDate(event.target.value)}
                  style={inputStyle}
                />
              </>
            )}

            <label htmlFor="document-amount" style={labelStyle}>
              {kind === "saldo" ? "Saldo confirmado (R$)" : "Valor da dívida (R$)"}
            </label>
            <input
              id="document-amount"
              inputMode="decimal"
              value={amount}
              onChange={(event) => setAmount(event.target.value)}
              style={inputStyle}
              required
              placeholder="Ex.: 1250,90"
            />

            <button
              type="submit"
              disabled={saving || loading}
              style={{
                width: "100%",
                marginTop: 22,
                padding: "15px 18px",
                border: 0,
                borderRadius: 12,
                background: saving || loading ? "#91aeb4" : "#087e8b",
                color: "#fff",
                fontSize: 16,
                fontWeight: 700,
                cursor: saving || loading ? "wait" : "pointer",
              }}
            >
              {saving ? "Salvando..." : "Confirmar e salvar dados"}
            </button>
          </form>

          {extractedText && (
            <details style={{ marginTop: 24 }}>
              <summary style={{ cursor: "pointer", fontWeight: 700 }}>
                Conferir texto extraído
              </summary>
              <pre style={{
                whiteSpace: "pre-wrap",
                overflowWrap: "anywhere",
                maxHeight: 300,
                overflow: "auto",
                padding: 14,
                background: "#f4f8fa",
                borderRadius: 10,
                fontSize: 12,
              }}>
                {extractedText.slice(0, 20000)}
              </pre>
            </details>
          )}
        </section>

        <p style={{
          color: "#58717a",
          fontSize: 13,
          lineHeight: 1.7,
          marginTop: 18,
        }}>
          Privacidade: esta página não envia os arquivos para o armazenamento
          do Supabase. O processamento ocorre temporariamente no navegador.
          Os valores só são gravados depois da confirmação. Confira sempre
          os dados extraídos antes de salvar.
        </p>
      </div>
    </main>
  );
}

const labelStyle: React.CSSProperties = {
  display: "block",
  marginTop: 18,
  marginBottom: 7,
  fontWeight: 700,
  fontSize: 14,
};

const inputStyle: React.CSSProperties = {
  display: "block",
  width: "100%",
  boxSizing: "border-box",
  minHeight: 46,
  padding: "11px 12px",
  border: "1px solid #ccdde2",
  borderRadius: 10,
  background: "#fff",
  color: "#16313b",
  fontSize: 15,
};
