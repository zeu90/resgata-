                 const headers = csvRows[0] || [];
                 const amountIndex = headers.findIndex((value) =>
                   /^(valor da divida|valor devido|valor a pagar|valor em aberto|valor da conta|valor original|valor|valor r\$|vl|amount due|debt amount|amount)$/.test(normalizeHeader(value))
