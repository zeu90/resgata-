const money = (value: number) =>
  value.toLocaleString("pt-BR", {
    style: "currency",
    currency: "BRL",
  });

function parseAmount(value: string): number {
  let cleaned = value.replace(/[R$\s]/g, "");
  if (cleaned.includes(",")) {
    cleaned = cleaned.replace(/\./g, "").replace(",", ".");
  }
  return Number(cleaned);
}

function findAmount(text: string): string {
  const matches = [
    ...text.matchAll(
      /(?:R\$\s*)?(\d{1,3}(?:\.\d{3})*,\d{2}|\d+,\d{2}|\d+\.\d{2})/g,
    ),
  ];
  return matches.at(-1)?.[1]?.replace(/\./g, "").replace(",", ".") ?? "";
}

function findDate(text: string): string {
  const match = text.match(/\b(\d{2})[\/.-](\d{2})[\/.-](\d{4})\b/);
  if (!match) return "";
  const [, day, month, year] = match;
  const date = `${year}-${month}-${day}`;
  const parsed = new Date(`${date}T12:00:00`);
  return Number.isNaN(parsed.getTime()) ? "" :
    parsed.toISOString().slice(0, 10);
}

function parseCSV(text: string): string[][] {
  const rows: string[][] = [];
  let row: string[] = [];
  let cell = "";
  let quoted = false;

  for (let i = 0; i < text.length; i++) {
    const char = text[i];

    if (char === '"' && quoted && text[i + 1] === '"') {
      cell += '"';
      i++;
    } else if (char === '"') {
      quoted = !quoted;
    } else if ((char === "," || char === ";" || char === "\t") && !quoted) {
      row.push(cell.trim());
      cell = "";
    } else if ((char === "\n" || char === "\r") && !quoted) {
      if (char === "\r" && text[i + 1] === "\n") i++;
      row.push(cell.trim());
      if (row.some(Boolean)) rows.push(row);
      row = [];
      cell = "";
    } else {
      cell += char;
    }
  }

  row.push(cell.trim());
  if (row.some(Boolean)) rows.push(row);
  return rows;
}

async function readDocument(file: File): Promise<string> {
  const name = file.name.toLowerCase();

  if (name.endsWith(".csv")) {
    return await file.text();
  }

  if (name.endsWith(".xlsx") || name.endsWith(".xls")) {
    const XLSX = await import("xlsx");
    const workbook = XLSX.read(await file.arrayBuffer(), {
      type: "array",
      cellDates: true,
    });

    const firstSheetName = workbook.SheetNames[0];
    if (!firstSheetName) {
      throw new Error("A planilha Excel não contém abas.");
    }

    const sheet = workbook.Sheets[firstSheetName];
    const csv = XLSX.utils.sheet_to_csv(sheet, { FS: ";", RS: "\n" });

    if (!csv.trim()) {
      throw new Error("A primeira aba da planilha não contém dados.");
    }

    return csv;
  }

  if (file.type.startsWith("image/")) {
    const Tesseract = await import("tesseract.js");
    const result = await Tesseract.recognize(file, "por+eng");
    return result.data.text;
  }

  if (name.endsWith(".pdf") || file.type === "application/pdf") {
    const pdfjs = await import("pdfjs-dist/legacy/build/pdf.mjs");
    pdfjs.GlobalWorkerOptions.workerSrc =
      `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${pdfjs.version}/pdf.worker.min.mjs`;

    const bytes = new Uint8Array(await file.arrayBuffer());
    const pdf = await pdfjs.getDocument({ data: bytes }).promise;
    const pages: string[] = [];

    for (let i = 1; i <= Math.min(pdf.numPages, 15); i++) {
      const page = await pdf.getPage(i);
      const content = await page.getTextContent();
      pages.push(
        content.items
          .map((item) => ("str" in item ? item.str : ""))
          .join(" "),
      );
    }

    const text = pages.join("\n");
    if (text.trim()) return text;

    throw new Error(
      "Este PDF não contém texto selecionável. Tire uma captura de tela ou envie uma imagem para usar o OCR.",
    );
  }

  throw new Error("Formato não suportado. Envie PDF, JPG, PNG, CSV, XLSX ou XLS.");
}


function buildCsvDebtRows(
  text: string,
  userId: string,
  reviewedRows?: string[][],
) {
  const rows = reviewedRows?.length ? reviewedRows : parseCSV(text);
  if (rows.length < 2) return [];

  const normalize = (value: string) =>
    value.normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .replace(/[_-]+/g, " ")
      .replace(/\s+/g, " ")
      .trim();

  const headers = rows[0].map(normalize);

  const findColumn = (patterns: RegExp[]) =>
    headers.findIndex((header) =>
      patterns.some((pattern) => pattern.test(header))
    );

  const amountIndex = findColumn([
    /^valor da divida$/,
    /^valor devido$/,
    /^valor a pagar$/,
    /^valor em aberto$/,
    /^valor da conta$/,
    /^valor original$/,
    /^valor (r\$)?$/,
    /^vl$/,
    /^amount due$/,
    /^debt amount$/,
    /^amount$/,
  ]);

  const dateIndex = findColumn([
    /^vencimento$/,
    /^data de vencimento$/,
    /^dia de vencimento$/,
    /^data limite$/,
    /^due date$/,
    /^due$/,
  ]);

  const nameIndex = findColumn([
    /^descricao$/,
    /^nome da conta$/,
    /^nome$/,
    /^conta$/,
    /^servico$/,
    /^historico$/,
    /^description$/,
  ]);

  const creditorIndex = findColumn([
    /^credor$/,
    /^empresa$/,
    /^instituicao$/,
    /^fornecedor$/,
    /^prestador$/,
    /^quem$/,
    /^creditor$/,
  ]);

  const statusIndex = findColumn([
    /^status$/,
    /^situacao$/,
    /^situacao do pagamento$/,
    /^status do pagamento$/,
    /^pago$/,
    /^pagamento$/,
    /^payment status$/,
  ]);

  // Não tratar saldo bancário, total geral ou valor já pago como dívida.
  if (amountIndex < 0) return [];

  const result: {
    user_id: string;
    name: string;
    creditor: string;
    amount: number;
    due_date: string | null;
    category: string;
    priority: string;
    status: string;
  }[] = [];

  const seen = new Set<string>();

  for (const row of rows.slice(1)) {
    const rawAmount = row[amountIndex] ?? "";
    const amount = parseAmount(rawAmount);

    if (!rawAmount.trim() || !Number.isFinite(amount) || amount <= 0) {
      continue;
    }

    const name = (nameIndex >= 0 ? row[nameIndex] : "").trim();
    const creditor = (creditorIndex >= 0 ? row[creditorIndex] : "").trim();

    // Não inventar descrição ou credor: dados incompletos devem ser corrigidos.
    if (!name || !creditor) continue;

    const rawDate = dateIndex >= 0 ? (row[dateIndex] ?? "").trim() : "";
    let dueDate: string | null = null;

    if (/^\d{4}-\d{2}-\d{2}$/.test(rawDate)) {
      const parsed = new Date(`${rawDate}T12:00:00`);
      if (
        !Number.isNaN(parsed.getTime()) &&
        parsed.toISOString().slice(0, 10) === rawDate
      ) {
        dueDate = rawDate;
      }
    } else if (rawDate) {
      dueDate = findDate(rawDate) || null;
    }

    let status = "pendente";
    const rawStatus = statusIndex >= 0
      ? normalize(row[statusIndex] ?? "")
      : "";

    if (/^(pago|paga|quitado|quitada|sim|yes|paid)$/.test(rawStatus)) {
      status = "pago";
    } else if (
      /^(atrasado|atrasada|vencido|vencida|em atraso|overdue)$/.test(rawStatus)
    ) {
      status = "atrasado";
    }

    const key = [
      normalize(name),
      normalize(creditor),
      amount.toFixed(2),
      dueDate ?? "",
    ].join("|");

    if (seen.has(key)) continue;
    seen.add(key);

    result.push({
      user_id: userId,
      name,
      creditor,
      amount,
      due_date: dueDate,
      category: "outra",
      priority: "normal",
      status,
    });
  }

  return result;
}

