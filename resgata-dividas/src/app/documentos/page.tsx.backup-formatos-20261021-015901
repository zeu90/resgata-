                     ))}
                   </div>
                   <p style={{ margin: "9px 0 0", fontSize: 12, color: "#64748b" }}>
                     Ocultar uma coluna não apaga os dados originais da prévia.
                   </p>
                 </section>
               )}

               <div style={{ overflowX: "auto", borderRadius: 12, background: "#fff" }}>
                  <table style={{
                    width: "100%",
                    borderCollapse: "collapse",
                    minWidth: 600,
                    fontSize: 13,
                  }}>
                    <thead>
                      <tr style={{ background: "#e0f2fe", color: "#164e63" }}>
                        {(kind === "saldo"
                          ? ["Conta", "Saldo extraído", "Arquivo"]
                          : csvRows.length > 1
                            ? visibleColumns.map((column) => csvRows[0][column])
                            : ["Descrição", "Credor", "Vencimento", "Valor (R$)"]
                        ).map((heading, index) => (
                          <th key={index} style={{
                            padding: "12px 14px",
                            borderBottom: "1px solid #cbd5e1",
                            textAlign: "left",
                            whiteSpace: "nowrap",
                          }}>
                            {heading || `Coluna ${index + 1}`}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {kind === "saldo" ? (
                        <tr>
                          <td style={{ padding: 12, borderBottom: "1px solid #e2e8f0" }}>
                            {wallets.find((wallet) => wallet.id === walletId)?.name || "Conta não selecionada"}
                          </td>
                          <td style={{ padding: 12, borderBottom: "1px solid #e2e8f0", fontWeight: 800, color: "#0f766e" }}>
                            {money(parseAmount(amount))}
                          </td>
                          <td style={{ padding: 12, borderBottom: "1px solid #e2e8f0", overflowWrap: "anywhere" }}>
                            {fileName || "—"}
                          </td>
                        </tr>
                      ) : csvRows.length > 1 ? (
                        csvRows.slice(1, 101).map((row, rowIndex) => (
                          <tr key={rowIndex} style={{ background: rowIndex % 2 ? "#f8fafc" : "#fff" }}>
                            {visibleColumns.map((columnIndex) => (
                              <td key={columnIndex} style={{
                                padding: "6px 8px",
                                borderBottom: "1px solid #e2e8f0",
                                minWidth: 130,
                              }}>
                                <input
                                  aria-label={`Editar linha ${rowIndex + 2}, coluna ${csvRows[0][columnIndex] || columnIndex + 1}`}
                                  value={row[columnIndex] || ""}
                                  onChange={(event) => {
                                    const value = event.target.value;
                                    setCsvRows((current) => current.map((currentRow, currentIndex) =>
                                      currentIndex === rowIndex + 1
                                        ? currentRow.map((cell, cellIndex) => cellIndex === columnIndex ? value : cell)
                                        : currentRow
                                    ));
                                  }}
                                  style={{
                                    width: "100%",
                                    minWidth: 110,
                                    padding: "8px",
                                    border: "1px solid #cbd5e1",
                                    borderRadius: 7,
                                    background: "#fff",
                                    color: "#0f172a",
                                    fontSize: 13,
                                  }}
                                />
                              </td>
                            ))}
                          </tr>
                        ))
                      ) : (
                        <tr>
                          <td style={{ padding: 12, borderBottom: "1px solid #e2e8f0" }}>
                            {name.trim() || "Dívida importada"}
                          </td>
                          <td style={{ padding: 12, borderBottom: "1px solid #e2e8f0" }}>
                            {creditor.trim() || "Não identificado"}
                          </td>
                          <td style={{ padding: 12, borderBottom: "1px solid #e2e8f0" }}>
                            {date || "Data não identificada"}
                          </td>
                          <td style={{ padding: 12, borderBottom: "1px solid #e2e8f0", fontWeight: 800, color: "#b45309" }}>
                            {money(parseAmount(amount))}
                          </td>
                        </tr>
                      )}
                    </tbody>
                  </table>
                </div>

                <p style={{ margin: "12px 0 0", color: "#475569", fontSize: 13, lineHeight: 1.6 }}>
                  {kind === "divida" && csvRows.length > 1
                    ? `Prévia de até 100 linhas para conferência visual. Nenhum dado é importado.`
                    : "Esta é a prévia dos dados extraídos. Os dados não são salvos nesta etapa."}
                </p>

                {kind === "divida" && (
                  <div style={{
                    display: "flex",
                    flexWrap: "wrap",
                    gap: 12,
                    marginTop: 18,
                    alignItems: "center",
                  }}>
                    <button
                      type="button"
                      onClick={() => void saveReviewedData()}
                      disabled={saving || loading || !reviewReady}
                      style={{
                        flex: "1 1 240px",
                        minHeight: 50,
                        padding: "14px 18px",
                        border: 0,
                        borderRadius: 12,
                        background: saving || loading
                          ? "#94a3b8"
                          : "linear-gradient(135deg, #15803d, #0f766e)",
                        color: "#fff",
                        fontSize: 15,
                        fontWeight: 800,
                        cursor: saving || loading ? "wait" : "pointer",
                      }}
                    >
                      {saving ? "Salvando..." : "✓ Confirmar e salvar dívidas"}
                    </button>
                    <span style={{
                      flex: "1 1 220px",
                      color: "#475569",
                      fontSize: 12,
                      lineHeight: 1.5,
                    }}>
                      Só serão salvas após sua confirmação. Confira os dados
                      e as datas antes de continuar.
                    </span>
                  </div>
                )}
              </section>
            )}
          </form>

        </section>

        <p style={{
          color: "#64748b",
          fontSize: 13,
          lineHeight: 1.7,
          marginTop: 18,
        }}>
          Privacidade: esta página processa os arquivos temporariamente no navegador.
          Nesta etapa, os dados são apenas coletados e exibidos para conferência;
          nenhuma dívida ou saldo é gravado no banco de dados.
        </p>
      </div>
    </main>
  );
}

const labelStyle: React.CSSProperties = {
  display: "block",
  marginTop: 18,
  marginBottom: 7,
  fontWeight: 700,
  fontSize: 14,
};

const inputStyle: React.CSSProperties = {
  display: "block",
  width: "100%",
  boxSizing: "border-box",
  minHeight: 48,
  padding: "12px 14px",
  border: "1px solid #cbd5e1",
  borderRadius: 12,
  background: "#fff",
  color: "#172033",
  fontSize: 15,
  outlineColor: "#087e8b",
};
