    } else if (extractedText.trim()) {
      setMessage("Arquivo preparado para visualização. Nada foi salvo.");
    } else {
      setMessage(
        "Arquivo selecionado. Não foi possível identificar dados para exibir."
      );
    }
  }

  return (
