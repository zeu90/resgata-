                 );

                 const parseCellAmount = (value: string) => {
                   const raw = String(value ?? "").trim();
                   if (!raw || !/\d/.test(raw)) return 0;
                   const parsed = parseAmount(raw);
                   return Number.isFinite(parsed) && parsed > 0 ? parsed : 0;
