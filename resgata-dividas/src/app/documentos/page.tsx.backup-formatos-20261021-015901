  const [fileName, setFileName] = useState("");
  const [selectedFileUrl, setSelectedFileUrl] = useState("");
  const [selectedFileType, setSelectedFileType] = useState("");
  const [sourceFile, setSourceFile] = useState<File | null>(null);
  const [selectionStart, setSelectionStart] = useState<{ x: number; y: number } | null>(null);
  const [selectionEnd, setSelectionEnd] = useState<{ x: number; y: number } | null>(null);
  const [imageNaturalSize, setImageNaturalSize] = useState({ width: 0, height: 0 });
  const imageRef = useRef<HTMLImageElement>(null);
  const selectingRef = useRef(false);
  const [extractedText, setExtractedText] = useState("");
  const [name, setName] = useState("");
  const [creditor, setCreditor] = useState("");
  const [amount, setAmount] = useState("");
  const [date, setDate] = useState("");
  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState("");
  const [error, setError] = useState("");
  const [csvRows, setCsvRows] = useState<string[][]>([]);
  const [visibleColumns, setVisibleColumns] = useState<number[]>([]);
  const [reviewReady, setReviewReady] = useState(false);

  useEffect(() => {
    if (!selectedFileUrl) return;
    return () => URL.revokeObjectURL(selectedFileUrl);
  }, [selectedFileUrl]);

  useEffect(() => {
    let active = true;

    async function load() {
      const supabase = getSupabaseBrowserClient();
      const { data, error: authError } = await supabase.auth.getUser();

      if (!active) return;
      if (authError || !data.user) {
        router.replace("/login");
        return;
      }

      setUserId(data.user.id);

      const { data: accounts, error: accountError } = await supabase
        .from("wallet_accounts")
        .select("id,name,account_type,balance")
        .eq("user_id", data.user.id)
        .order("created_at", { ascending: true });

      if (!active) return;

      if (accountError) {
        setError("Não foi possível carregar suas contas financeiras.");
        return;
      }

      setWallets((accounts ?? []) as Wallet[]);
      if (accounts?.length) setWalletId(accounts[0].id);
    }

    void load();
    return () => {
      active = false;
    };
  }, [router]);

  async function handleFile(file?: File) {
    if (!file) return;

    setLoading(true);
    setError("");
    setMessage("");
    setFileName(file.name);
    setSourceFile(file);
    setSelectionStart(null);
    setSelectionEnd(null);
   setSelectedFileUrl(URL.createObjectURL(file));
   setSelectedFileType(
     file.type ||
       (file.name.toLowerCase().endsWith(".pdf")
         ? "application/pdf"
         : file.name.toLowerCase().endsWith(".csv")
           ? "text/csv"
           : ""),
   );
    setExtractedText("");
    setCsvRows([]);
    setReviewReady(false);

    try {
      const text = await readDocument(file);
      setExtractedText(text);

      if (/\.(csv|xlsx|xls)$/i.test(file.name)) {
        const rows = parseCSV(text);
        setCsvRows(rows);
       setVisibleColumns(rows[0].map((_, index) => index));

        if (rows.length > 1) {
          setMessage(
            `CSV lido: ${rows.length - 1} linhas de dados. Confira a tabela antes de importar.`,
          );

          const headers = rows[0].map((h) => h.toLowerCase());
          const amountIndex = headers.findIndex((h) =>
            /valor|saldo|amount|total/.test(h),
          );
          const dateIndex = headers.findIndex((h) =>
            /data|vencimento|date/.test(h),
          );
          const descriptionIndex = headers.findIndex((h) =>
            /descri|nome|credor|hist.rico|description/.test(h),
          );

          const first = rows[1];
          if (amountIndex >= 0 && first[amountIndex]) {
            setAmount(String(parseAmount(first[amountIndex])));
          }
          if (dateIndex >= 0 && first[dateIndex]) {
            setDate(findDate(first[dateIndex]) || first[dateIndex]);
          }
          if (descriptionIndex >= 0 && first[descriptionIndex]) {
            setName(first[descriptionIndex]);
            setCreditor(first[descriptionIndex]);
          }
        } else {
          setError("O CSV não contém linhas de dados suficientes.");
        }
      } else {
        setAmount(findAmount(text));
        setDate(findDate(text));

        const lines = text
          .split(/\r?\n/)
          .map((line) => line.trim())
          .filter(Boolean);

        const candidate = lines.find(
          (line) =>
            line.length >= 3 &&
            !/R\$|saldo|vencimento|vencida|pagamento|extrato/i.test(line),
        );

        if (candidate) {
          setName(candidate.slice(0, 100));
          setCreditor(candidate.slice(0, 100));
        }

        setMessage(
          "Leitura concluída. Confira e corrija os campos antes de salvar.",
        );
      }
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Não foi possível ler o documento.",
      );
    } finally {
      setLoading(false);
    }
  }


  async function saveReviewedData() {
    if (!reviewReady || !fileName) {
      setError("Primeiro prepare e confira o arquivo.");
      return;
    }

    if (kind !== "divida") {
      setError(
        "A gravação de saldo está desativada nesta etapa para proteger sua conta financeira."
      );
      return;
    }

    setSaving(true);
    setError("");
    setMessage("");

    try {
      const supabase = getSupabaseBrowserClient();
      const { data: auth, error: authError } = await supabase.auth.getUser();

      if (authError) throw authError;

      if (!auth.user) {
        router.replace("/login");
        return;
      }

      const currentUserId = auth.user.id;

      type DebtInsert = {
        user_id: string;
        name: string;
        creditor: string;
        amount: number;
        due_date: string;
        category: string;
        priority: string;
        status: string;
      };

      let records: DebtInsert[] = [];

      if (csvRows.length > 1) {
        // Só importa colunas identificadas como valor da dívida.
        // Não trata VL, TOT, saldo ou F.PAG isoladamente como dívida.
        const parsed = buildCsvDebtRows(extractedText, currentUserId, csvRows);

        if (parsed.length === 0) {
          throw new Error(
            "Nenhuma dívida válida foi identificada. Confira as colunas de descrição, credor e valor."
          );
        }

        const invalidDates = parsed.filter((item) => {
          if (!item.due_date || !/^\d{4}-\d{2}-\d{2}$/.test(item.due_date)) {
            return true;
          }

          const parsedDate = new Date(`${item.due_date}T12:00:00`);
          return (
            Number.isNaN(parsedDate.getTime()) ||
            parsedDate.toISOString().slice(0, 10) !== item.due_date
          );
        });

        if (invalidDates.length > 0) {
          throw new Error(
            `${invalidDates.length} conta(s) estão sem vencimento válido. Corrija a coluna de vencimento na tabela e confirme novamente. Nenhuma dívida foi salva nesta tentativa.`
          );
        }

        records = parsed.map((item) => ({
          ...item,
          due_date: item.due_date as string,
        }));
      } else {
        const cleanName = name.trim();
        const cleanCreditor = creditor.trim();
        const numericAmount = parseAmount(amount);
        const dueDate = date.trim();

        if (!cleanName || !cleanCreditor) {
          throw new Error("Preencha a descrição e o credor antes de salvar.");
        }

        if (!Number.isFinite(numericAmount) || numericAmount <= 0) {
          throw new Error("Informe um valor válido maior que zero.");
        }

        if (!/^\d{4}-\d{2}-\d{2}$/.test(dueDate)) {
          throw new Error(
            "Informe uma data de vencimento válida no formato AAAA-MM-DD."
          );
        }

        const parsedDate = new Date(`${dueDate}T12:00:00`);
        if (
          Number.isNaN(parsedDate.getTime()) ||
          parsedDate.toISOString().slice(0, 10) !== dueDate
        ) {
          throw new Error("A data de vencimento não é válida.");
        }

        records = [{
          user_id: currentUserId,
          name: cleanName,
          creditor: cleanCreditor,
          amount: numericAmount,
          due_date: dueDate,
          category: "outra",
          priority: "normal",
          status: "pendente",
        }];
      }

      if (records.length === 0) {
        throw new Error(
          "Nenhuma dívida válida foi identificada. Para importar uma planilha, ela precisa ter uma coluna de valor com cabeçalho reconhecido, descrição/credor e vencimento. Confira os nomes das colunas e as datas."
        );
      }

      // Consulta os registros do usuário para evitar duplicatas óbvias.
      const { data: existing, error: existingError } = await supabase
        .from("debts")
        .select("name,creditor,amount,due_date")
        .eq("user_id", currentUserId);

      if (existingError) throw existingError;

      const normalize = (value: string) =>
        value.normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .trim()
          .toLowerCase();

      const duplicateKey = (item: {
        name: string;
        creditor: string;
        amount: number | string;
        due_date: string;
      }) => [
        normalize(item.name),
        normalize(item.creditor),
        Number(item.amount).toFixed(2),
        item.due_date,
      ].join("|");

      const known = new Set(
        ((existing ?? []) as {
          name: string;
          creditor: string;
          amount: number | string;
          due_date: string;
        }[]).map((item) =>
          duplicateKey({
            name: item.name,
            creditor: item.creditor,
            amount: item.amount,
            due_date: item.due_date,
          })
        )
      );

      const seenInFile = new Set<string>();
      const uniqueRecords = records.filter((item) => {
        const key = duplicateKey(item);

        if (known.has(key) || seenInFile.has(key)) return false;

        seenInFile.add(key);
        return true;
      });

      if (uniqueRecords.length === 0) {
        setMessage(
          "Nenhuma dívida nova foi salva: os registros já existem no sistema ou estão repetidos no arquivo."
        );
        return;
      }

      const { error: insertError } = await supabase
        .from("debts")
        .insert(uniqueRecords);

      if (insertError) throw insertError;

      setMessage(
        `${uniqueRecords.length} dívida(s) salva(s) com sucesso. ${
          records.length - uniqueRecords.length
        } registro(s) repetido(s) foram ignorados. Consulte a página Dívidas para conferir.`
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Não foi possível salvar os registros."
      );
    } finally {
      setSaving(false);
    }
  }

