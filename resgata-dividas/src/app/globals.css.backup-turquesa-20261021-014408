}

.dash-savings-stat span {
  color: #687e75;
  font-size: 12px;
  font-weight: 650;
}

.dash-savings-stat strong {
  color: #12654e;
  font-size: clamp(21px, 3vw, 29px);
  overflow-wrap: anywhere;
  font-variant-numeric: tabular-nums;
}

.dash-savings-empty {
  margin: 16px 0 0;
  color: #5f786e;
  font-size: 13px;
  line-height: 1.7;
}

.dash-savings-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 20px;
  padding-top: 18px;
  border-top: 1px solid #d5e8df;
}

.dash-savings-footer p {
  flex: 1;
  min-width: 220px;
  margin: 0;
  color: #72847c;
  font-size: 12px;
  line-height: 1.8;
}

.dash-savings-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 11px 15px;
  border: 1px solid #b8dacc;
  border-radius: 11px;
  background: #fff;
  color: #08745d;
  font-size: 13px;
  font-weight: 750;
  text-decoration: none;
}

.dash-savings-button:hover {
  background: #e2f5ec;
}

.dash-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 32px;
  padding-top: 20px;
  border-top: 1px solid #d9e4ed;
  color: #7a8c9d;
  font-size: 12px;
}

.dash-footer span:first-child {
  color: #31536b;
  font-weight: 750;
}

@media (max-width: 1050px) {
  .dash-stat-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .dash-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .dash-nav {
    justify-content: flex-start;
  }
}

@media (max-width: 600px) {
  .dashboard-page {
    padding: 14px 12px 24px;
  }

  .dash-welcome {
    align-items: stretch;
    flex-direction: column;
    gap: 20px;
    margin: 20px 0;
    padding: 23px 19px;
    border-radius: 19px;
  }

  .dash-welcome h1 {
    font-size: 30px;
  }

  .dash-primary-button {
    width: 100%;
    box-sizing: border-box;
  }

  .dash-stat-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 11px;
  }

  .dash-stat-card {
    padding: 18px;
  }

  .dash-stat-value {
    margin-top: 15px;
    font-size: 25px;
  }

  .dash-savings-section {
    padding: 20px 16px;
  }

  .dash-savings-stats {
    gap: 9px;
  }

  .dash-savings-stat {
    padding: 13px 11px;
  }

  .dash-savings-footer {
    align-items: stretch;
    flex-direction: column;
  }

  .dash-savings-button {
    width: 100%;
    box-sizing: border-box;
  }

  .dash-footer {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  .dash-spinner {
    animation: none;
