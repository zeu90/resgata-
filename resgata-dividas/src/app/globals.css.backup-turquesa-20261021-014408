@import "tailwindcss";

:root {
  --bg: #f5f7fb;
  --surface: #ffffff;
  --text: #172238;
  --muted: #68758a;
  --primary: #126b58;
  --primary-dark: #0b4f42;
  --border: #e2e8f0;
  --success: #16794b;
  --danger: #b42318;
  --radius: 18px;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

a { color: var(--primary); text-decoration: none; }
a:hover { text-decoration: underline; }

button, input, select, textarea { font: inherit; }
button, .btn { cursor: pointer; }

.container {
  width: min(1120px, calc(100% - 36px));
  margin-inline: auto;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 18px 0;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--text);
  font-size: 1.2rem;
  font-weight: 800;
  letter-spacing: -.5px;
}

.brand-mark {
  display: grid;
  width: 40px;
  height: 40px;
  place-items: center;
  border-radius: 13px;
  color: white;
  background: var(--primary);
  font-weight: 800;
}

.navlinks {
  display: flex;
  align-items: center;
  gap: 22px;
  flex-wrap: wrap;
  font-size: .94rem;
}

.navlinks a { color: var(--text); }

.hero {
  position: relative;
  overflow: hidden;
  padding: 36px 0 44px;
  background:
    radial-gradient(ellipse at 85% 20%, #cceee2 0, transparent 35%),
    linear-gradient(135deg, #f5faf8, #edf4fb);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  gap: 48px;
  align-items: center;
}

.eyebrow {
  display: inline-flex;
  padding: 7px 12px;
  border: 1px solid #cce7dc;
  border-radius: 999px;
  color: var(--primary-dark);
  background: #effaf5;
  font-size: .82rem;
  font-weight: 700;
}

.hero h1 {
  max-width: 720px;
  margin: 20px 0;
  font-size: clamp(2.3rem, 5vw, 4.2rem);
  line-height: 1.08;
  letter-spacing: -2px;
}

.hero h1 span { color: var(--primary); }

.hero p {
  max-width: 610px;
  color: var(--muted);
  font-size: 1.1rem;
}

.actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 28px;
}

.btn {
  display: inline-flex;
  min-height: 46px;
  align-items: center;
  justify-content: center;
  padding: 11px 18px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: var(--primary);
  color: white;
  font-weight: 700;
  text-align: center;
  transition: background .2s, transform .2s;
}

.btn:hover {
  background: var(--primary-dark);
  color: white;
  text-decoration: none;
  transform: translateY(-1px);
}

.btn-secondary {
  border-color: var(--border);
  background: white;
  color: var(--text);
}

.btn-secondary:hover { background: #f8fafc; color: var(--text); }

.btn-block { width: 100%; }

.hero-card, .panel, .feature, .stat-card, .auth-card {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: 0 12px 36px rgba(20, 39, 65, .055);
}

.hero-card { padding: 26px; }

.hero-card h2 { margin-top: 0; }

.preview-balance {
  margin: 20px 0;
  padding: 22px;
  border-radius: 15px;
  color: white;
  background: linear-gradient(135deg, #126b58, #174f72);
}

.preview-balance small { opacity: .85; }
.preview-balance strong {
  display: block;
  margin-top: 8px;
  font-size: 2rem;
}

.preview-line {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 13px 0;
  border-bottom: 1px solid var(--border);
}

.preview-line:last-child { border-bottom: 0; }

.section { padding: 68px 0; }
.section-white { background: white; }

.section-heading {
  max-width: 700px;
  margin: 0 auto 32px;
  text-align: center;
}

.section-heading h2 {
  margin: 0 0 12px;
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  line-height: 1.2;
  letter-spacing: -.8px;
}

.section-heading p { color: var(--muted); }

.grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.panel, .feature { padding: 24px; }
.feature h3 { margin: 12px 0 8px; }
.feature p, .muted { color: var(--muted); }

.feature-icon {
  display: grid;
  width: 46px;
  height: 46px;
  place-items: center;
  border-radius: 14px;
  background: #e9f6f0;
  font-size: 1.35rem;
}

.page { padding: 38px 0 72px; }
.page h1 { margin: 0 0 8px; font-size: 2rem; }
.page-subtitle { margin: 0 0 28px; color: var(--muted); }

.form {
  display: grid;
  gap: 17px;
}

.field {
  display: grid;
  gap: 7px;
  color: var(--text);
  font-size: .93rem;
  font-weight: 650;
}

.field input, .field select, .field textarea,
input, select, textarea {
  max-width: 100%;
}

.field input, .field select, .field textarea {
  width: 100%;
  min-height: 46px;
  padding: 11px 13px;
  border: 1px solid #cfd8e3;
  border-radius: 11px;
  outline: none;
  background: white;
  color: var(--text);
}

.field textarea { min-height: 100px; resize: vertical; }

.field input:focus, .field select:focus, .field textarea:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(18, 107, 88, .12);
}

.auth-page {
  min-height: calc(100vh - 80px);
  display: grid;
  place-items: center;
  padding: 42px 18px 64px;
  background:
    radial-gradient(ellipse at 20% 10%, #dcefe7 0, transparent 35%),
    var(--bg);
}

.auth-card {
  width: min(100%, 460px);
  padding: clamp(24px, 5vw, 38px);
}

.auth-card h1 { margin: 22px 0 8px; font-size: 1.9rem; }
.auth-card > p { color: var(--muted); }
.auth-footer { margin-top: 22px; text-align: center; font-size: .93rem; }
.auth-links { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.notice, .error, .success {
  padding: 12px 14px;
  border-radius: 11px;
  font-size: .92rem;
}
.notice { background: #eff6ff; color: #1d4f91; }
.error { background: #fff1f0; color: var(--danger); }
.success { background: #ecfdf3; color: var(--success); }

.tablewrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; }
th, td {
  padding: 13px 12px;
  border-bottom: 1px solid var(--border);
  text-align: left;
  white-space: nowrap;
}
th { color: var(--muted); font-size: .85rem; }

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}
.stat-card { padding: 20px; }
.stat-card small { color: var(--muted); }
.stat-card strong { display: block; margin-top: 8px; font-size: 1.7rem; }

.footer {
  padding: 30px 0;
  border-top: 1px solid var(--border);
  background: white;
  color: var(--muted);
  font-size: .9rem;
}
.footer-inner {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

@media (max-width: 760px) {
  .hero { padding: 24px 0 36px; }
  .hero-grid { grid-template-columns: 1fr; gap: 28px; }
  .grid, .stats-grid { grid-template-columns: 1fr; }
  .nav { align-items: flex-start; flex-direction: column; }
  .navlinks { gap: 12px 18px; }
  .hero h1 { letter-spacing: -1px; }
  .section { padding: 48px 0; }
}

/* ===== Resgata Dívidas — home renovada ===== */
.home-nav {
  min-height: 78px;
  padding-top: 14px;
  padding-bottom: 14px;
}

.home-brand-light { font-weight: 500; }

.home-nav .navlinks { gap: 20px; }
.home-nav-cta { gap: 8px; box-shadow: 0 7px 18px rgba(18, 107, 88, .16); }

.home-hero {
  padding: 48px 0 64px;
  background:
    radial-gradient(ellipse at 85% 18%, rgba(166, 231, 205, .60), transparent 38%),
    radial-gradient(ellipse at 5% 100%, rgba(207, 226, 255, .48), transparent 42%),
    linear-gradient(135deg, #f7fbf9 0%, #f0f7f5 48%, #f0f5fc 100%);
}

.home-hero-grid {
  grid-template-columns: 1.02fr .98fr;
  gap: clamp(28px, 5vw, 64px);
}

.home-copy { position: relative; z-index: 1; }

.home-eyebrow,
.home-section-kicker {
  color: #126b58;
  font-size: .76rem;
  font-weight: 800;
  letter-spacing: 1.45px;
}

.home-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 9px 13px;
  border: 1px solid #d3e9df;
  border-radius: 999px;
  background: rgba(255,255,255,.78);
  letter-spacing: .7px;
}

.home-live-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #15976d;
  box-shadow: 0 0 0 4px rgba(21,151,109,.12);
}

.home-hero .hero h1,
.home-hero h1 {
  max-width: 650px;
  margin: 24px 0 20px;
  font-size: clamp(2.8rem, 5vw, 4.5rem);
  line-height: 1.04;
  letter-spacing: -2.8px;
  font-weight: 800;
}

.home-hero h1 span {
  color: #14755f;
  background: linear-gradient(100deg, #14755f, #236f91);
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.home-lead {
  max-width: 540px;
  margin: 0;
  color: #5e6e7f;
  font-size: 1.08rem;
  line-height: 1.85;
}

.home-actions {
  gap: 13px;
  margin-top: 28px;
}

.home-primary-cta {
  gap: 12px;
  min-height: 52px;
  padding: 13px 20px;
  border-radius: 13px;
  background: linear-gradient(135deg, #14745e, #105744);
  box-shadow: 0 9px 22px rgba(18,107,88,.19);
}

.home-primary-cta:hover { background: #0b4f42; }

.home-secondary-cta {
  min-height: 52px;
  padding: 13px 18px;
  border-color: #d9e5e3;
  background: rgba(255,255,255,.76);
}

.home-trust {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 24px;
  color: #68788a;
  font-size: .87rem;
}

.home-trust-icon {
  display: grid;
  width: 21px;
  height: 21px;
  place-items: center;
  border-radius: 50%;
  background: #dff4e9;
  color: #147451;
  font-size: .75rem;
  font-weight: 900;
}

.home-mini-benefits {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
  margin-top: 19px;
  color: #49675f;
  font-size: .83rem;
}

.home-mini-benefits span { display: inline-flex; gap: 6px; }
.home-mini-benefits span span { color: #14805f; font-weight: 900; }

.home-visual {
  position: relative;
  display: grid;
  min-width: 0;
  place-items: center;
  padding: 14px 8px 25px;
}

.home-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(1px);
}

.home-orb-one {
  top: 0;
  right: 5%;
  width: 170px;
  height: 170px;
  background: rgba(167, 222, 204, .30);
}

.home-orb-two {
  bottom: 0;
  left: 0;
  width: 135px;
  height: 135px;
  background: rgba(184, 209, 245, .32);
}

.home-dashboard {
  position: relative;
  z-index: 1;
  width: min(100%, 460px);
  padding: 25px;
  border: 1px solid rgba(222, 232, 235, .95);
  border-radius: 23px;
  background: rgba(255,255,255,.96);
  box-shadow: 0 28px 75px rgba(35, 67, 76, .13), 0 3px 10px rgba(35,67,76,.04);
}

.home-dashboard-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 17px;
}

.home-dashboard-label {
  color: #718395;
  font-size: .66rem;
  font-weight: 800;
  letter-spacing: 1.1px;
}

.home-dashboard-top h2 {
  margin: 4px 0 0;
  color: #1c2d3c;
  font-size: 1.55rem;
  letter-spacing: -.7px;
}

.home-dashboard-symbol {
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  border: 1px solid #e1eee8;
  border-radius: 13px;
  background: #f0f8f4;
  color: #126b58;
  font-size: 1.2rem;
}

.home-example-notice {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 12px;
  color: #66778a;
  font-size: .72rem;
}

.home-balance-card {
  overflow: hidden;
  padding: 21px;
  border-radius: 17px;
  color: white;
  background:
    radial-gradient(ellipse at 95% 0%, rgba(111, 205, 167, .28), transparent 45%),
    linear-gradient(125deg, #104f45, #175f70);
}

.home-balance-card > span {
  color: #d4e9e4;
  font-size: .78rem;
}

.home-balance-card > strong {
  display: block;
  margin: 7px 0 17px;
  font-size: clamp(1.8rem, 3vw, 2.25rem);
  line-height: 1.2;
  letter-spacing: -.9px;
}

.home-balance-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  padding-top: 12px;
  border-top: 1px solid rgba(255,255,255,.17);
  color: #d4e9e4;
  font-size: .72rem;
}

.home-dashboard-section-title {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin: 22px 0 8px;
  color: #243647;
  font-size: .87rem;
}

.home-dashboard-section-title span {
  color: #8b98a6;
  font-size: .72rem;
  font-weight: 500;
}

.home-task {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 12px 0;
  border-bottom: 1px solid #edf1f4;
}

.home-task:last-of-type { border-bottom: 0; }

.home-task-icon {
  display: grid;
  flex: 0 0 39px;
  width: 39px;
  height: 39px;
  place-items: center;
  border-radius: 12px;
  font-weight: 800;
}

.home-task-purple { background: #f0eaff; color: #7452bb; }
.home-task-green { background: #e5f7ed; color: #188052; }
.home-task-orange { background: #fff1df; color: #b76b17; }

.home-task-text {
  display: grid;
  min-width: 0;
  gap: 2px;
}

.home-task-text strong { color: #263747; font-size: .82rem; }
.home-task-text small { color: #84909e; font-size: .7rem; }

.home-task-status {
  margin-left: auto;
  color: #26775f;
  font-size: .7rem;
  font-weight: 750;
}

.home-task-arrow {
  margin-left: auto;
  color: #7d8e9d;
}

.home-dashboard-link {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin-top: 14px;
  padding-top: 15px;
  border-top: 1px solid #edf1f4;
  color: #176d59;
  font-size: .78rem;
  font-weight: 750;
}

.home-floating-note {
  position: absolute;
  right: -10px;
  bottom: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 13px 16px;
  border: 1px solid #e1ebe5;
  border-radius: 15px;
  background: white;
  box-shadow: 0 12px 35px rgba(35,67,76,.12);
}

.home-floating-icon {
  display: grid;
  width: 39px;
  height: 39px;
  place-items: center;
  border-radius: 12px;
  background: #e8f7ed;
  font-size: 1.2rem;
}

.home-floating-note > span:last-child { display: grid; gap: 2px; }
.home-floating-note strong { color: #253747; font-size: .78rem; }
.home-floating-note small { color: #718092; font-size: .7rem; }

.home-proof-strip {
  border-top: 1px solid #e5eee9;
  border-bottom: 1px solid #e5eee9;
  background: rgba(255,255,255,.82);
}

.home-proof-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding-top: 23px;
  padding-bottom: 23px;
}

.home-proof-grid > div {
  display: grid;
  grid-template-columns: 38px 1fr;
  align-content: center;
  column-gap: 12px;
  padding: 2px 22px;
  border-right: 1px solid #e7eeeb;
}

.home-proof-grid > div:first-child { padding-left: 0; }
.home-proof-grid > div:last-child { border-right: 0; }

.home-proof-grid > div > span {
  grid-row: span 2;
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  border-radius: 11px;
  background: #eaf6f0;
  color: #14755f;
  font-size: .78rem;
  font-weight: 850;
}

.home-proof-grid strong { color: #263849; font-size: .9rem; }
.home-proof-grid small { color: #7a8794; font-size: .76rem; }

.home-section { padding-top: 82px; padding-bottom: 82px; }

.home-section-heading { max-width: 720px; margin-bottom: 39px; }
.home-section-heading h2,
.home-resource-copy h2 {
  margin: 13px 0;
  color: #1b2e3e;
  font-size: clamp(2rem, 3.5vw, 2.8rem);
  line-height: 1.14;
  letter-spacing: -1.4px;
}

.home-section-heading p,
.home-resource-copy > p {
  color: #68798a;
  line-height: 1.8;
}

.home-feature-grid { gap: 20px; }

.home-feature {
  padding: 26px;
  border-color: #e4ebe9;
  border-radius: 18px;
  box-shadow: 0 7px 24px rgba(28, 57, 64, .035);
  transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
}

.home-feature:hover {
  transform: translateY(-4px);
  border-color: #cce4d8;
  box-shadow: 0 15px 32px rgba(28,57,64,.075);
}

.home-feature-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home-feature-icon { width: 52px; height: 52px; border-radius: 15px; }
.home-feature-number { color: #a0adaf; font-size: .82rem; font-weight: 800; }
.home-feature h3 { margin-top: 22px; color: #263849; font-size: 1.08rem; }
.home-feature p { margin-bottom: 0; color: #6c7a89; font-size: .92rem; line-height: 1.75; }

.home-resources {
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  align-items: center;
  gap: clamp(32px, 7vw, 90px);
}

.home-resource-copy > p { max-width: 460px; margin-bottom: 25px; }
.home-resource-list {
  padding: 9px 23px;
  border: 1px solid #e7eeeb;
  border-radius: 19px;
  background: #fff;
  box-shadow: 0 14px 36px rgba(28,57,64,.045);
}

.home-resource-list article {
  display: grid;
  grid-template-columns: 38px 1fr 27px;
  align-items: center;
  gap: 12px;
  padding: 20px 0;
  border-bottom: 1px solid #edf1ef;
}

.home-resource-list article:last-child { border-bottom: 0; }

.home-resource-list article > span:first-child {
  color: #168064;
  font-size: .83rem;
  font-weight: 850;
}

.home-resource-list h3 { margin: 0 0 5px; color: #273949; font-size: .94rem; }
.home-resource-list p { margin: 0; color: #788694; font-size: .82rem; line-height: 1.6; }

.home-resource-check {
  display: grid;
  width: 27px;
  height: 27px;
  place-items: center;
  border-radius: 50%;
  background: #e7f7ed;
  color: #168054;
  font-size: .8rem;
  font-weight: 900;
}

.home-plan-wrap {
  display: grid;
  grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
  align-items: stretch;
  gap: 22px;
  max-width: 900px;
  margin: 0 auto;
}

.home-plan-card {
  padding: 30px;
  border: 1px solid #cfe6da;
  border-radius: 21px;
  background: linear-gradient(160deg, #fff, #f5fbf7);
  box-shadow: 0 15px 42px rgba(27, 88, 68, .07);
}

.home-plan-label {
  color: #14755f;
  font-size: .73rem;
  font-weight: 850;
  letter-spacing: 1px;
}

.home-plan-card h3 { margin: 12px 0; color: #203544; font-size: 1.5rem; }
.home-plan-card > p { color: #6c7b88; font-size: .92rem; line-height: 1.75; }

.home-plan-card ul {
  display: grid;
  gap: 12px;
  margin: 24px 0;
  padding: 0;
  list-style: none;
}

.home-plan-card li {
  display: flex;
  gap: 10px;
  color: #405565;
  font-size: .9rem;
}

.home-plan-card li::before {
  content: "✓";
  color: #14805f;
  font-weight: 900;
}

.home-plan-note {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 32px;
  border: 1px solid #e3eaf0;
  border-radius: 21px;
  background: #fff;
}

