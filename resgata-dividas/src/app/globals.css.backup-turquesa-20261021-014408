/* RESGATA HABITOS CONTROLE - TEMA VISUAL */
.habits-page {
  width: min(1180px, calc(100% - 32px)) !important;
  margin: 0 auto !important;
  padding: 24px 0 48px !important;
  color: #172033 !important;
}

.habits-page > header {
  position: relative;
  overflow: hidden;
  padding: clamp(24px, 5vw, 44px) !important;
  margin-bottom: 28px !important;
  border: 1px solid #b8e8d5;
  border-radius: 26px;
  background:
    radial-gradient(ellipse at 90% 10%, rgba(255,255,255,.65), transparent 38%),
    linear-gradient(135deg, #d9fbe9 0%, #ecfdf5 48%, #e0f2fe 100%);
  box-shadow: 0 14px 38px rgba(16, 120, 83, .09);
}

.habits-page h1 {
  color: #104c3b;
  letter-spacing: -1.2px;
  line-height: 1.12;
}

.habits-page h2 {
  color: #164e40;
  letter-spacing: -.4px;
}

.habits-page h3 {
  color: #17634f;
}

.habits-page section {
  border-radius: 22px !important;
  border: 1px solid #e0eae7 !important;
  box-shadow: 0 8px 26px rgba(24, 55, 46, .055) !important;
}

.habits-page section h2 {
  margin-bottom: 12px;
}

.habits-page section p {
  line-height: 1.75;
}

.habits-page input,
.habits-page select,
.habits-page textarea {
  width: 100%;
  min-height: 46px;
  padding: 11px 13px !important;
  border: 1px solid #cbded6 !important;
  border-radius: 12px !important;
  background: #fff !important;
  color: #172033 !important;
  outline: none;
  transition: border-color .18s ease, box-shadow .18s ease;
}

.habits-page input:focus,
.habits-page select:focus,
.habits-page textarea:focus {
  border-color: #0d9b70 !important;
  box-shadow: 0 0 0 3px rgba(13, 155, 112, .13) !important;
}

.habits-page button {
  min-height: 44px;
  padding: 10px 17px !important;
  border-radius: 12px !important;
  font-weight: 750;
  transition: transform .18s ease, filter .18s ease, box-shadow .18s ease;
}

.habits-page button:hover:not(:disabled) {
  filter: brightness(.97);
  transform: translateY(-1px);
  box-shadow: 0 5px 14px rgba(15, 90, 65, .13);
}

.habits-page button:disabled {
  cursor: wait;
  opacity: .65;
}

.habits-page a {
  transition: color .18s ease;
}

.habits-page a:focus-visible,
.habits-page button:focus-visible {
  outline: 3px solid #38bdf8;
  outline-offset: 3px;
}

.habits-page article {
  border-radius: 16px;
  transition: box-shadow .18s ease, transform .18s ease;
}

.habits-page article:hover {
  box-shadow: 0 8px 20px rgba(24, 55, 46, .07);
}

.habits-page [role="alert"] {
  border: 1px solid #fecdd3;
}

.habits-page [role="status"] {
  border: 1px solid #a7f3d0;
}

@media (min-width: 760px) {
  .habits-page > section {
    margin-bottom: 24px;
    padding: 28px !important;
  }
}

@media (max-width: 600px) {
  .habits-page {
    width: calc(100% - 22px) !important;
    padding-top: 12px !important;
  }

  .habits-page > header {
    padding: 23px 19px !important;
    border-radius: 20px;
  }

  .habits-page section {
    border-radius: 17px !important;
  }

  .habits-page button {
    max-width: 100%;
    white-space: normal;
  }
}

@media (prefers-reduced-motion: reduce) {
  .habits-page *,
  .habits-page *::before,
  .habits-page *::after {
    transition: none !important;
    scroll-behavior: auto !important;
  }
}
