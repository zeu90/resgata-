/* Laterais com efeito de rasgo / corte */
body::before,
body::after {
  content: "";
  position: fixed;
  top: 0;
  bottom: 0;
  width: 14px;
  z-index: 9999;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    #075e68 0%,
    #087f8c 25%,
    #075e68 55%,
    #0a8b91 80%,
    #064e59 100%
  );
  filter: drop-shadow(0 0 3px rgba(5, 75, 84, 0.35));
}

/* Lateral esquerda recortada */
body::before {
  left: 0;
  clip-path: polygon(
    0 0, 100% 0,
    65% 4%, 100% 8%,
    60% 13%, 100% 18%,
    68% 24%, 100% 30%,
    58% 36%, 100% 42%,
    68% 48%, 100% 54%,
    60% 60%, 100% 66%,
    68% 72%, 100% 78%,
    58% 84%, 100% 90%,
    68% 96%, 100% 100%,
    0 100%
  );
}

/* Lateral direita recortada */
body::after {
  right: 0;
  clip-path: polygon(
    0 0, 100% 0,
    100% 100%, 0 100%,
    32% 96%, 0 90%,
    42% 84%, 0 78%,
    32% 72%, 0 66%,
    40% 60%, 0 54%,
    32% 48%, 0 42%,
    42% 36%, 0 30%,
    32% 24%, 0 18%,
    40% 13%, 0 8%,
    35% 4%
  );
}

/* Recorte mais delicado em celulares */
@media (max-width: 760px) {
  body::before,
  body::after {
    width: 7px;
  }
}

/* Cabeçalho ocupando toda a largura da página */
.home-nav {
  display: flex;
  width: 100%;
